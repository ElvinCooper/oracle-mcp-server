# ============================================================================
# CONFIGURACION MULTI-CONEXION (Recomendado)
# ============================================================================
# Copia este archivo a .env y completa tus credenciales:
#   copy .env.example .env   (Windows) / cp .env.example .env (Linux/Mac)
# Define multiples conexiones a Oracle separadas por comas.
# Cada conexion tiene su propio prefijo: ORACLE_CONN_<NOMBRE>_*


# Lista de conexiones (nombres separados por comas)
ORACLE_CONNECTIONS=facturacion,clinica

# --- Conexion "facturacion" ---
ORACLE_CONN_FACTURACION_USER=mi_usuario
ORACLE_CONN_FACTURACION_PASSWORD=mi_password
ORACLE_CONN_FACTURACION_HOST=192.168.1.10
ORACLE_CONN_FACTURACION_PORT=1521
ORACLE_CONN_FACTURACION_SID=ORCL
# ORACLE_CONN_FACTURACION_SERVICE_NAME=orclpdb1
# En Windows usa la ruta completa, ej: C:\oracle\instantclient_11_2
# En Linux/Mac: /opt/oracle/instantclient_11_2
ORACLE_CONN_FACTURACION_CLIENT_LIB_DIR=C:\oracle\instantclient_11_2
ORACLE_CONN_FACTURACION_ALLOW_WRITE=false
ORACLE_CONN_FACTURACION_MAX_ROWS=200
ORACLE_CONN_FACTURACION_CONNECT_TIMEOUT=10
ORACLE_CONN_FACTURACION_POOL_MIN=1
ORACLE_CONN_FACTURACION_POOL_MAX=4

# --- Conexion "clinica" ---
ORACLE_CONN_CLINICA_USER=clinica_user
ORACLE_CONN_CLINICA_PASSWORD=clinica_pass
ORACLE_CONN_CLINICA_HOST=192.168.1.20
ORACLE_CONN_CLINICA_PORT=1521
ORACLE_CONN_CLINICA_SID=ORCL
ORACLE_CONN_CLINICA_CLIENT_LIB_DIR=C:\oracle\instantclient_11_2
ORACLE_CONN_CLINICA_ALLOW_WRITE=false
ORACLE_CONN_CLINICA_MAX_ROWS=200


# ============================================================================
# CREDENCIALES VIA VARIABLES DEL SISTEMA (Opcional)
# ============================================================================
# Alternativa para no guardar credenciales en texto plano. Define USER y
# PASSWORD como variables de entorno del sistema y deja solo la referencia
# en este archivo (se resuelve con ${VAR}):
#
#   Windows:  [Environment]::SetEnvironmentVariable("ORACLE_FACTURACION_USER", "mi_usuario", "User")
#   Linux:    export ORACLE_FACTURACION_USER="mi_usuario"
#
# ORACLE_CONN_FACTURACION_USER=${ORACLE_FACTURACION_USER}
# ORACLE_CONN_FACTURACION_PASSWORD=${ORACLE_FACTURACION_PASSWORD}
#
# O bien define las variables con el MISMO nombre de la conexion
# (ORACLE_CONN_FACTURACION_USER / ORACLE_CONN_FACTURACION_PASSWORD); en ese
# caso tienen prioridad sobre este archivo. Ver README seccion 3.


# ============================================================================
# CONFIGURACION LEGACY (Una sola conexion - Retrocompatible)
# ============================================================================
# Si ORACLE_CONNECTIONS no esta definido, el servidor busca estas variables.

# ORACLE_USER=mi_usuario
# ORACLE_PASSWORD=mi_password
# ORACLE_HOST=192.168.1.10
# ORACLE_PORT=1521
# ORACLE_SID=ORCL
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_11_2    # Windows
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_11_2  # Linux/Mac
# ORACLE_ALLOW_WRITE=false
# ORACLE_MAX_ROWS=200
# ORACLE_CONNECT_TIMEOUT=10
# ORACLE_POOL_MIN=1
# ORACLE_POOL_MAX=4
