# --- Conexion a Oracle 11g ---
ORACLE_USER=mi_usuario
ORACLE_PASSWORD=mi_password
ORACLE_HOST=192.168.1.10
ORACLE_PORT=1521

# Usa UNA de las dos opciones (11g normalmente trabaja con SID):
ORACLE_SID=ORCL
# ORACLE_SERVICE_NAME=orclpdb1

# --- Oracle Instant Client (obligatorio para thick mode / 11g) ---
# Ruta donde tienes descomprimido el Instant Client (contiene libclntsh.so / oci.dll, etc.)
ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_11_2

# --- Seguridad ---
# En "true" habilita INSERT/UPDATE/DELETE/DDL a traves de la tool execute_statement.
# Por defecto queda en "false": el MCP solo permite SELECT (modo solo lectura).
ORACLE_ALLOW_WRITE=false

# Limite maximo de filas que puede devolver una consulta (protege el contexto del LLM)
ORACLE_MAX_ROWS=200

# Timeout de conexion en segundos
ORACLE_CONNECT_TIMEOUT=10

# Tamaño del pool de conexiones
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
